# ---------------------------------------------------------------------------
# Digital Solution Studio - backoffice (Laravel + Filament)
# Copier ce fichier en .env puis adapter. Ne JAMAIS versionner .env.
# Aucune valeur ci-dessous n'est un secret reel : les secrets sont a saisir
# uniquement dans le .env local ou dans les variables de l'hebergeur.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="Digital Solution Studio"
APP_ENV=local
# Generee par : php artisan key:generate (ne pas la partager, ne pas la versionner)
APP_KEY=
# false en production
APP_DEBUG=true
# URL publique du backoffice / de l'API (a decider : voir README)
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de donnees : PostgreSQL ------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dss_backoffice
DB_USERNAME=dss
DB_PASSWORD=
DB_SSLMODE=prefer

# --- Redis (cache, files d'attente, limitation de debit) -------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- Sessions du backoffice ------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true obligatoire en production (HTTPS)
SESSION_SECURE_COOKIE=false

# --- E-mail ----------------------------------------------------------------
# log = ecrit dans storage/logs (developpement). En production : smtp, resend, postmark...
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="devis@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Demandes de devis -----------------------------------------------------
# Adresse qui recoit la notification de chaque demande (laisser vide : la demande est
# enregistree mais aucun e-mail n'est envoye)
QUOTE_TO_EMAIL=
# Origines autorisees (CORS et controle d'origine du POST /api/v1/quotes),
# separees par des virgules, sans barre finale
ALLOWED_ORIGINS=https://mon-cv-fr.vercel.app
# Proxys de confiance pour lire l'IP du visiteur (limitation de debit) :
# vide = aucun ; "*" = tous (uniquement derriere un proxy maitrise) ; ou une liste d'IP/CIDR
TRUSTED_PROXIES=

# --- Import / export avec le site statique ---------------------------------
# Dossier des JSON du site (relatif a backend/ ou absolu)
SITE_DATA_PATH=../assets/data

# --- Administrateur --------------------------------------------------------
# Lus par : php artisan admin:create (le mot de passe est demande, ou fourni une seule
# fois via ADMIN_PASSWORD dans l'environnement du shell, jamais dans ce fichier versionne)
ADMIN_EMAIL=
ADMIN_NAME="Administrateur"
